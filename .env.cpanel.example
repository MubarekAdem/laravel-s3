APP_NAME="Object Storage"
APP_ENV=production
# Generate once on first installation. Preserve this key on every update and restore.
APP_KEY=
APP_DEBUG=false
APP_URL=https://storage.example.com

# Optional initial owner. Never commit populated credentials.
ADMIN_NAME="Storage Owner"
ADMIN_EMAIL=
ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANELUSER_objectstore
DB_USERNAME=CPANELUSER_objectstore
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No persistent queue worker is required with sync.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="storage@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# This service stores objects locally. No AWS credentials are needed.
OBJECT_STORE_REGION=us-east-1
# Replace CPANELUSER. This directory must remain outside every web document root.
OBJECT_STORE_PATH=/home/CPANELUSER/object-store-data
OBJECT_STORE_MAX_BYTES=104857600
OBJECT_STORE_TRASH_DAYS=30
OBJECT_STORE_MULTIPART_HOURS=24

VITE_APP_NAME="${APP_NAME}"
